# Database. "embedded" starts a local PostgreSQL under .data/pg (no install needed) when you run
# pnpm dev, pnpm worker or the db:* scripts. Docker Compose and production set a real URL.
DATABASE_URL=embedded

# Signs the demo-session cookie. Use a long random string in any shared environment.
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Base address used in QR codes and recipient links.
APP_URL=http://localhost:3000

# AI. Leave the key empty and every AI job runs on built-in rules ("Built-in rules" in the header).
# Provider is "claude" (Anthropic API) or "mock" (canned answers, used by the tests).
ANTHROPIC_API_KEY=
AI_PROVIDER=claude
AI_MODEL_QUICK=claude-haiku-4-5
AI_MODEL_DEFAULT=claude-opus-5
RATE_LIMIT_AI_PER_MIN=20

# Media storage: "local" writes under STORAGE_PATH. "s3" is the documented seam (not built yet).
STORAGE_DRIVER=local
STORAGE_PATH=./.data/uploads
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

LOG_LEVEL=info
